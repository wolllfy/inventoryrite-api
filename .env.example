# Required for Clover App Market
CLOVER_CLIENT_ID=your_production_client_id
CLOVER_CLIENT_SECRET=your_production_secret
CLOVER_APP_ID=your_app_id_from_clover_dashboard
CLOVER_APP_NAME=InventoryRite
CLOVER_ENV=production
APP_BASE_URL=https://your-app.onrender.com
REDIRECT_URI=https://your-app.onrender.com/oauth-callback

# Security - generate with: openssl rand -hex 32
ENCRYPTION_KEY=64_char_hex_key_here
CLOVER_WEBHOOK_SECRET=your_webhook_secret

# Database - required for production/App Market behavior
DATABASE_URL=postgresql://username:password@host:5432/database
PGSSLMODE=require

# Optional
APP_VERSION=1.0.0
CLOVER_ITEM_LIMIT=100
CLOVER_API_RATE_LIMIT_MAX=100
PORT=3000
REQUEST_TIMEOUT_MS=20000
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
